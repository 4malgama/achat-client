/*
 * AChat Client dark theme.
 *
 * Values wrapped in double braces are populated from dark.json by
 * ThemeManager. Keep palette values and reusable metrics in JSON so both
 * QSS controls and custom-painted widgets consume the same theme data.
 */

* {
	color: {{textPrimary}};
	outline: none;
}

QWidget {
	selection-background-color: {{accentHover}};
	selection-color: {{textOnAccent}};
}

QDialog,
QMessageBox {
	background-color: {{windowBackground}};
}

QLabel {
	background: transparent;
	color: {{textPrimary}};
}

QLabel:disabled {
	color: {{textMuted}};
}

/* Main window */

#Client {
	background: qlineargradient(
		x1: 0, y1: 0, x2: 1, y2: 1,
		stop: 0 {{windowBackground}},
		stop: 0.55 {{panelBackground}},
		stop: 1 {{surfaceBackground}}
	);
}

#Client #centralwidget,
#Client #frame,
#frameAdvert,
ChatsWidget,
SearchWidget,
#ProfileWidget,
ChatsWidget #mainFrame,
ChatsWidget #messagesContent,
SearchWidget #resultsContent,
#ProfileWidget #areaComments,
#ProfileWidget #areaSettings {
	background: transparent;
	border: none;
}

/* Custom title bar */

#frameBorder {
	background: qlineargradient(
		x1: 0, y1: 0, x2: 1, y2: 0,
		stop: 0 {{panelBackground}},
		stop: 1 {{surfaceBackground}}
	);
	border: none;
	border-bottom: {{borderWidth}}px solid {{border}};
}

#frameBorder #btnClose,
#frameBorder #btnSize,
#frameBorder #btnHide {
	background: transparent;
	border: none;
	border-radius: {{radiusSmall}}px;
	padding: 0;
}

#frameBorder #btnClose:hover {
	background-color: {{danger}};
}

#frameBorder #btnSize:hover,
#frameBorder #btnHide:hover {
	background-color: {{surfaceHover}};
}

#frameBorder #btnClose:pressed,
#frameBorder #btnSize:pressed,
#frameBorder #btnHide:pressed {
	background-color: {{surfacePressed}};
}

/* Side navigation */

#frameSide {
	background: qlineargradient(
		x1: 0, y1: 0, x2: 0, y2: 1,
		stop: 0 {{panelBackground}},
		stop: 1 {{windowBackground}}
	);
	border: none;
	border-right: {{borderWidth}}px solid {{border}};
}

#frameSide QToolButton {
	background-color: {{inputBackground}};
	border: {{borderWidth}}px solid transparent;
	border-radius: {{radiusLarge}}px;
	padding: {{spacingSm}}px;
}

#frameSide QToolButton:hover {
	background-color: {{surfaceHover}};
	border-color: {{inputFocusBorder}};
}

#frameSide QToolButton:pressed {
	background-color: {{surfacePressed}};
	border-color: {{accentHover}};
}

#frameSide QToolButton:disabled {
	background-color: {{panelBackground}};
	border-color: {{border}};
}

/* Text inputs */

QLineEdit,
QAbstractSpinBox,
QComboBox {
	min-height: {{smallControlContentHeight}}px;
	background-color: {{inputBackground}};
	color: {{textPrimary}};
	placeholder-text-color: {{textMuted}};
	border: {{borderWidth}}px solid {{inputBorder}};
	border-radius: {{radiusMedium}}px;
	padding: 0 {{spacingMd}}px;
}

QTextEdit,
QPlainTextEdit {
	background-color: {{inputBackground}};
	color: {{textPrimary}};
	placeholder-text-color: {{textMuted}};
	border: {{borderWidth}}px solid {{inputBorder}};
	border-radius: {{radiusMedium}}px;
	padding: {{spacingSm}}px;
}

QLineEdit:hover,
QAbstractSpinBox:hover,
QComboBox:hover,
QTextEdit:hover,
QPlainTextEdit:hover {
	background-color: {{surfaceBackground}};
	border-color: {{borderStrong}};
}

QLineEdit:focus,
QAbstractSpinBox:focus,
QComboBox:focus,
QTextEdit:focus,
QPlainTextEdit:focus {
	background-color: {{inputBackground}};
	border-color: {{inputFocusBorder}};
}

QLineEdit:disabled,
QAbstractSpinBox:disabled,
QComboBox:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled {
	background-color: {{panelBackground}};
	color: {{textMuted}};
	border-color: {{border}};
}

QLineEdit[readOnly="true"],
QTextEdit[readOnly="true"],
QPlainTextEdit[readOnly="true"] {
	background-color: {{panelBackground}};
	color: {{textSecondary}};
}

/* Buttons */

QPushButton,
QToolButton {
	min-height: {{smallControlContentHeight}}px;
	background-color: {{surfaceBackground}};
	color: {{textPrimary}};
	border: {{borderWidth}}px solid {{border}};
	border-radius: {{radiusMedium}}px;
	padding: 0 {{spacingMd}}px;
}

QPushButton:hover,
QToolButton:hover {
	background-color: {{surfaceHover}};
	border-color: {{inputFocusBorder}};
}

QPushButton:pressed,
QToolButton:pressed,
QPushButton:checked,
QToolButton:checked {
	background-color: {{surfacePressed}};
	border-color: {{accentHover}};
}

QPushButton:disabled,
QToolButton:disabled {
	background-color: {{panelBackground}};
	color: {{textMuted}};
	border-color: {{border}};
}

QPushButton[role="primary"] {
	background-color: {{accent}};
	color: {{textOnAccent}};
	border-color: {{accentHover}};
}

QPushButton[role="primary"]:hover {
	background-color: {{accentHover}};
}

QPushButton[role="primary"]:pressed {
	background-color: {{accentPressed}};
}

/* Combo boxes and item views */

QComboBox {
	padding-right: 30px;
}

QComboBox::drop-down {
	background: transparent;
	border: none;
	width: 30px;
}

QComboBox::down-arrow {
	image: url(:/r/resources/images/expand_arrow.png);
	width: 10px;
	height: 10px;
}

QComboBox:on {
	border-color: {{inputFocusBorder}};
	border-bottom-left-radius: 0;
	border-bottom-right-radius: 0;
}

QAbstractItemView {
	background-color: {{inputBackground}};
	color: {{textPrimary}};
	border: {{borderWidth}}px solid {{borderStrong}};
	selection-color: {{textOnAccent}};
	selection-background-color: {{accentPressed}};
	padding: {{spacingXs}}px;
}

QAbstractItemView::item {
	min-height: {{smallControlContentHeight}}px;
	padding: {{spacingXs}}px {{spacingSm}}px;
	border-radius: {{radiusSmall}}px;
}

QAbstractItemView::item:hover,
QAbstractItemView::item:selected {
	background-color: {{surfaceHover}};
}

/* Check boxes */

QCheckBox {
	color: {{textSecondary}};
	spacing: {{spacingSm}}px;
}

QCheckBox:disabled {
	color: {{textMuted}};
}

QCheckBox::indicator {
	width: 18px;
	height: 18px;
	background-color: {{inputBackground}};
	border: {{borderWidth}}px solid {{borderStrong}};
	border-radius: {{radiusSmall}}px;
}

QCheckBox::indicator:hover {
	background-color: {{surfaceHover}};
	border-color: {{inputFocusBorder}};
}

QCheckBox::indicator:checked {
	background-color: {{accentHover}};
	border-color: {{accentHover}};
	image: url(:/r/resources/images/check.png);
}

QCheckBox::indicator:disabled {
	background-color: {{panelBackground}};
	border-color: {{border}};
}

/* Sliders */

QSlider::groove:horizontal {
	height: 5px;
	background: {{surfaceBackground}};
	border-radius: 2px;
}

QSlider::sub-page:horizontal {
	background: {{accent}};
	border-radius: 2px;
}

QSlider::handle:horizontal {
	width: 16px;
	margin: -6px 0;
	background: {{accentHover}};
	border: {{borderWidth}}px solid {{textOnAccent}};
	border-radius: 8px;
}

QSlider::handle:horizontal:hover {
	background: {{accentPressed}};
}

/* Scroll areas and scroll bars */

QScrollArea {
	background: transparent;
	border: none;
}

QScrollArea > QWidget > QWidget {
	background: transparent;
}

QScrollBar:vertical {
	background: transparent;
	width: 8px;
	margin: 2px;
}

QScrollBar::handle:vertical {
	min-height: 28px;
	background: {{borderStrong}};
	border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
	background: {{accentHover}};
}

QScrollBar:horizontal {
	background: transparent;
	height: 8px;
	margin: 2px;
}

QScrollBar::handle:horizontal {
	min-width: 28px;
	background: {{borderStrong}};
	border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
	background: {{accentHover}};
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
	background: transparent;
	border: none;
	width: 0;
	height: 0;
}

/* Menus, tooltips, and separators */

QMenu {
	background-color: {{panelBackground}};
	color: {{textPrimary}};
	border: {{borderWidth}}px solid {{borderStrong}};
	border-radius: {{radiusMedium}}px;
	padding: {{spacingXs}}px;
}

QMenu::item {
	min-width: 140px;
	min-height: {{smallControlContentHeight}}px;
	padding: {{spacingXs}}px {{spacingMd}}px;
	border-radius: {{radiusSmall}}px;
}

QMenu::item:selected {
	background-color: {{surfaceHover}};
}

QMenu::item:disabled {
	color: {{textMuted}};
}

QMenu::separator {
	height: 1px;
	background: {{border}};
	margin: {{spacingXs}}px {{spacingSm}}px;
}

QToolTip {
	background-color: {{surfaceBackground}};
	color: {{textPrimary}};
	border: {{borderWidth}}px solid {{borderStrong}};
	border-radius: {{radiusSmall}}px;
	padding: {{spacingXs}}px {{spacingSm}}px;
}

/* Profile */

#ProfileWidget #btnProfileLink,
#ProfileWidget #btnSendComment {
	background-color: {{accent}};
	color: {{textOnAccent}};
	border-color: {{accentHover}};
}

#ProfileWidget #btnProfileLink:hover,
#ProfileWidget #btnSendComment:hover {
	background-color: {{accentHover}};
}

#ProfileWidget #btnProfileLink:pressed,
#ProfileWidget #btnSendComment:pressed {
	background-color: {{accentPressed}};
}

#ProfileWidget #leFirstname,
#ProfileWidget #lePatronymic,
#ProfileWidget #leSurname {
	color: {{textPrimary}};
}

#ProfileWidget #lePost,
#ProfileWidget #textAboutMe,
#ProfileWidget #textComment {
	color: {{textSecondary}};
}

#ProfileWidget #settingsContent,
#ProfileWidget #commentsContent {
	background-color: {{panelBackground}};
	border: {{borderWidth}}px solid {{border}};
	border-radius: {{radiusLarge}}px;
}

#ProfileWidget #settingsContent QLabel,
#ProfileWidget #lblNoComments {
	color: {{textSecondary}};
}

#ProfileWidget #btnUpdate {
	min-height: 0;
	background: transparent;
	border-color: transparent;
	border-radius: {{radiusMedium}}px;
	padding: 0;
}

#ProfileWidget #btnUpdate:hover {
	background-color: {{surfaceHover}};
	border-color: {{inputFocusBorder}};
}

#ProfileWidget #btnUpdate:pressed {
	background-color: {{surfacePressed}};
}

/* Authorization */

AuthorizationWidget {
	background: transparent;
}

AuthorizationWidget #title {
	color: {{textPrimary}};
}

AuthorizationWidget QPushButton {
	background-color: {{accent}};
	color: {{textOnAccent}};
	border-color: {{accentHover}};
}

AuthorizationWidget QPushButton:hover {
	background-color: {{accentHover}};
}

AuthorizationWidget QPushButton:pressed {
	background-color: {{accentPressed}};
}

AuthorizationWidget QPushButton:disabled {
	background-color: {{panelBackground}};
	color: {{textMuted}};
	border-color: {{border}};
}

/* Chats */

ChatsWidget #headerFrame {
	background-color: {{panelBackground}};
	border: none;
	border-bottom: {{borderWidth}}px solid {{border}};
}

ChatsWidget #scrollChats {
	background-color: {{panelBackground}};
	border: none;
	border-right: {{borderWidth}}px solid {{border}};
}

ChatsWidget #chatsContent {
	background-color: {{panelBackground}};
}

ChatsWidget #scrollMessages {
	background: transparent;
	border: none;
}

ChatsWidget #txtMessage {
	padding: {{spacingXs}}px {{spacingSm}}px;
	border-radius: {{radiusLarge}}px;
}

ChatsWidget #btnAttach,
ChatsWidget #btnSend,
ChatsWidget #btnVoice,
ChatsWidget #btnStartCall,
ChatsWidget #btnMenu {
	min-height: 0;
	background: transparent;
	border-color: transparent;
	border-radius: {{radiusMedium}}px;
	padding: {{spacingXs}}px;
}

ChatsWidget #btnAttach:hover,
ChatsWidget #btnSend:hover,
ChatsWidget #btnVoice:hover,
ChatsWidget #btnStartCall:hover,
ChatsWidget #btnMenu:hover {
	background-color: {{surfaceHover}};
	border-color: {{inputFocusBorder}};
}

ChatsWidget #btnAttach:pressed,
ChatsWidget #btnSend:pressed,
ChatsWidget #btnVoice:pressed,
ChatsWidget #btnStartCall:pressed,
ChatsWidget #btnMenu:pressed {
	background-color: {{surfacePressed}};
}

ChatsWidget #nickname {
	color: {{textPrimary}};
}

ChatsWidget #frame {
	background-color: {{surfaceBackground}};
	border: {{borderWidth}}px solid {{border}};
	border-radius: {{radiusMedium}}px;
}

ChatsWidget #frame QLabel {
	color: {{textSecondary}};
}

ChatsWidget #typingLabel {
	color: {{textMuted}};
	font-style: italic;
}

/* Search */

SearchWidget #btnSearch {
	background-color: {{accent}};
	color: {{textOnAccent}};
	border-color: {{accentHover}};
}

SearchWidget #btnSearch:hover {
	background-color: {{accentHover}};
}

SearchWidget #btnSearch:pressed {
	background-color: {{accentPressed}};
}

SearchWidget #leText {
	border-radius: {{radiusLarge}}px;
}

/* Calls */

CallNotifyWidget QToolButton[callAction="accept"] {
	min-height: 0;
	background-color: {{success}};
	border-color: {{success}};
	border-radius: {{radiusLarge}}px;
	padding: {{spacingSm}}px;
}

CallNotifyWidget QToolButton[callAction="reject"] {
	min-height: 0;
	background-color: {{danger}};
	border-color: {{danger}};
	border-radius: {{radiusLarge}}px;
	padding: {{spacingSm}}px;
}

CallNotifyWidget QToolButton:hover {
	border-color: {{textOnAccent}};
}

CallNotifyWidget QToolButton:pressed {
	background-color: {{surfacePressed}};
}

/* Dialogs */

MessageWidget,
ServerMessageWidget {
	background: transparent;
}

MessageWidget QPushButton,
ServerMessageWidget QPushButton {
	background-color: {{surfaceBackground}};
	border-color: {{borderStrong}};
}

/* Console */

ConsoleWidget {
	background-color: {{windowBackground}};
}

ConsoleWidget #plainTextEdit {
	background-color: {{panelBackground}};
	color: {{consoleText}};
	border-color: {{border}};
}

ConsoleWidget #lineEdit {
	background-color: {{inputBackground}};
	color: {{consoleText}};
}
